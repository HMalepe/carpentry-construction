{
  "name": "malepe-rr-website",
  "version": "1.0.0",
  "private": true,
  "description": "Website for Malepe R and R (Pty) Ltd: construction, maintenance and carpentry in Hoedspruit, Limpopo.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:prod": "STRICT=1 node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "lint": "node scripts/build.mjs && html-validate dist && node --check src/assets/js/main.js scripts/build.mjs scripts/lib.mjs scripts/serve.mjs",
    "test:unit": "node --test tests/unit.test.mjs tests/build.test.mjs",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e.test.mjs",
    "test": "node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "check": "npm run lint && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "axe-core": "4.11.0",
    "html-validate": "^11.21.1",
    "playwright": "1.63.0"
  }
}
